# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:7357,http://localhost:3000

# MongoDB Atlas or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/smart_factory

# Long, private signing key for API and Socket.IO sessions.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# The seeded factory dataset belongs only to this demo account.
DEMO_USER_EMAIL=demo@factory.local
DEMO_USER_PASSWORD=replace-with-a-strong-password-at-least-12-characters
